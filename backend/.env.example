# Backend API — copy to `.env` and fill in.

# Set true when credentials and return URLs are ready.
CARD_PAYMENT_ENABLED=false

# --- MAIB e-Commerce Checkout (recommended) ---
# Sandbox API: https://sandbox.maibmerchants.md | Production: https://api.maibmerchants.md
MAIB_SANDBOX=1
MAIB_CLIENT_ID=
MAIB_CLIENT_SECRET=
MAIB_SIGNATURE_KEY=
MAIB_RETURN_SUCCESS=http://localhost:8080/maib/success
MAIB_RETURN_CANCEL=http://localhost:8080/maib/cancel
# Public URL for server-side payment callbacks (ngrok in dev, deployed API in prod)
MAIB_CALLBACK_URL=

# --- Paynet (legacy, optional) ---

# Demo merchant from cms-api/ReadMe.txt — uses built-in test keys (no secrets needed in .env except optional overrides).
PAYNET_DEBUG_HARDCODED=0

# Merchant API — test vs prod (must match how Paynet registered your merchant)
PAYNET_API_ORIGIN=https://api-merchant.test.paynet.md
PAYNET_CHECKOUT_POST_URL=https://test.paynet.md/acquiring/getecom
# Production example:
# PAYNET_API_ORIGIN=https://api-merchant.paynet.md
# PAYNET_CHECKOUT_POST_URL=https://paynet.md/acquiring/getecom

PAYNET_MERCHANT_CODE=
PAYNET_SALE_AREA_CODE=
PAYNET_MERCHANT_SEC_KEY=
PAYNET_MERCHANT_USER=
PAYNET_MERCHANT_USER_PASS=

# ISO 4217 numeric — 498 MDL, 978 EUR (must match what Paynet expects for your merchant)
PAYNET_CURRENCY=498

PAYNET_SERVICE_NAME=Card order

# Paynet IPN → must be a PUBLIC URL hitting your deployed API (or ngrok → :3001). Empty OK until deploy.
PAYNET_NOTIFICATION_URL=
PAYNET_NOTIFICATION_SEC_KEY=

# Return URLs — Red Light Therapy routes (/paynet/success, /paynet/cancel). Must be whitelisted in Paynet.
PAYNET_RETURN_SUCCESS=http://localhost:8080/paynet/success
PAYNET_RETURN_CANCEL=http://localhost:8080/paynet/cancel
# GitHub Pages production (replace OWNER; repo uses base /redlight-therapy-lamps/):
# PAYNET_RETURN_SUCCESS=https://OWNER.github.io/redlight-therapy-lamps/paynet/success
# PAYNET_RETURN_CANCEL=https://OWNER.github.io/redlight-therapy-lamps/paynet/cancel

PAYNET_SERVER_PORT=3001

# Telegram — după plată confirmată. Bot: @BotFather → token; chat_id din getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
